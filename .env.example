POSTGRES_USER=warehouse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=warehouse
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8080

# Used by the API and by `dotnet ef` (also as WAREHOUSE_DB_CONNECTION).
WAREHOUSE_DB_CONNECTION=Host=localhost;Port=5432;Database=warehouse;Username=warehouse;Password=change-me

# JWT signing key (required in non-Development; Development appsettings has a local default).
# Jwt__SigningKey=replace-with-a-long-random-secret-at-least-32-chars
JWT_SIGNING_KEY=replace-with-a-long-random-secret-at-least-32-chars

# Session lifetimes (optional; defaults: access 180 min, refresh 14 days, Scan & Go 3 hours)
# JWT_ACCESS_TOKEN_MINUTES=180
# JWT_REFRESH_TOKEN_DAYS=14
# SELF_CHECKOUT_SESSION_HOURS=3

# Production compose overlay (docker-compose.prod.yml)
# DOMAIN=app.example.com
# WEB_ORIGIN=https://app.example.com
# PLATFORM_ORIGIN=https://platform.example.com
# POSTGRES_PASSWORD=strong-password

# Stripe (optional until billing enabled)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# Stripe__PriceIds__STANDARD=price_...
# Stripe__PriceIds__ENTERPRISE=price_...

# Resala SMS/OTP (optional; key starts with rsl_ — never commit real keys)
# RESALA_API_KEY=rsl_...
# Host only — do NOT append /api/v1
# RESALA_BASE_URL=https://dev.resala.ly
# RESALA_SENDER=MyBrand
# RESALA_RECEIPT_SMS_TEMPLATE_ID=<approved-template-guid>
# Template: single placeholder $1 = compact invoice details (e.g. اهلا بك هده تفاصيل الفاتوة $1)

# SMTP email (Gmail app password recommended on Render; outbound SMTP is often blocked)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SENDER_NAME=Modern Tech POS
# SMTP_SENDER_EMAIL=you@gmail.com
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=...
# SMTP_ENABLE_SSL=true
# SMTP_SERVER=smtp.office365.com

# After seed/restore once on a host: WAREHOUSE_RESTORE_ON_START=false

# Optional: dump OpenTelemetry spans/metrics to console
# OTEL_EXPORTER_CONSOLE=true
